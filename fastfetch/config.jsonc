{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo_custom.txt",
        "type": "file",
        "color": {
            "1": "38;2;249;226;175" // Yellow (Mocha)
        }
    },
    "display": {
        "constants": [
            "██ "
        ],
        "key": {
            "paddingLeft": 2
        }
    },
    "modules": [
        "break",
        "break",
        {
            "key": "{$1}Distro",
            "keyColor": "38;2;243;139;168", // Red
            "type": "os"
        },
        {
            "key": "{$1}Kernel",
            "keyColor": "38;2;166;227;161", // Green
            "type": "kernel"
        },
        {
            "key": "{$1}Shell",
            "keyColor": "38;2;137;180;250", // Blue
            "type": "shell"
        },
        {
            "key": "{$1}Packages",
            "keyColor": "38;2;245;194;231", // Pink/Magenta
            "type": "packages"
        },
        {
            "key": "{$1}WM",
            "keyColor": "38;2;148;226;213", // Cyan/Teal
            "type": "wm"
        },
        {
            "key": "{$1}CPU",
            "keyColor": "38;2;203;166;247", // Mauve/Purple
            "type": "cpu"
        },
        {
            "key": "{$1}Memory",
            "keyColor": "38;2;250;179;135", // Peach
            "type": "memory"
        }
    ]
}
